{
  "name": "pachapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pachapp by DJuaqo — PWA de e-learning gamificada para agrónomos",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "db:seed-sql": "node --experimental-strip-types --no-warnings scripts/generate-seed-sql.ts > supabase/seed.sql",
    "generate:questions": "node --experimental-strip-types --no-warnings generate_questions.ts",
    "db:batches-sql": "node --experimental-strip-types --no-warnings scripts/batches-to-sql.ts > supabase/batches.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
