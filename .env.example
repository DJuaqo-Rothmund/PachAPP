# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Correo(s) con acceso al panel /admin (separados por coma).
# Solo controla la UI; la seguridad real vive en las políticas RLS de Supabase.
VITE_ADMIN_EMAILS=joaquin.rothmund@gmail.com
